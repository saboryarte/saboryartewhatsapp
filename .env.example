# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio.

# Token que defines tú mismo; debe coincidir con el configurado en Meta Developers.
VERIFY_TOKEN=cambia_esto_por_un_valor_aleatorio_seguro

# Token de acceso permanente de la app de Meta (Graph API).
WHATSAPP_TOKEN=

# ID del número de teléfono en Meta Developers > WhatsApp > Configuration.
WHATSAPP_PHONE_NUMBER_ID=

# App Secret de tu app en Meta Developers (para validar firmas de payload).
APP_SECRET=

# API Key de Anthropic para consultar a Claude.
ANTHROPIC_API_KEY=

# Archivo SQLite con el estado de las conversaciones y los mensajes ya procesados.
# Contiene mensajes de clientes: no lo subas al repositorio (data/ está en .gitignore).
STATE_DB_PATH=data/conversaciones.db

# ── Traspaso a una persona ──
# Correo que recibe la ficha cuando el cliente pasa a una persona, y la alerta si nadie responde.
HANDOFF_EMAIL_TO=
# Servidor SMTP para enviar esos correos (con Gmail: smtp.gmail.com, puerto 587 y una "contraseña de aplicación").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Minutos de horario de atención sin respuesta del equipo antes de enviar la alerta.
HANDOFF_ALERT_MINUTES=60
# Horas sin mensajes del equipo tras las cuales el bot vuelve a responder solo.
HANDOFF_IDLE_HOURS=12

# ── Bold: links de pago ──
# Panel de Bold → Integraciones → Llaves de integración. Usa el par de pruebas o el de producción, nunca mezclados.
# Llave de identidad: crea los links de pago.
BOLD_API_KEY=
# Llave secreta: verifica la firma de los avisos de pago. Obligatoria en producción.
BOLD_SECRET_KEY=
# true SOLO con las llaves de pruebas (Bold firma los avisos de prueba con una llave vacía). En producción: false.
BOLD_SANDBOX=false
# Vigencia del link de pago, en horas.
BOLD_LINK_HOURS=24
# Botón «Volver a la tienda» del comprobante de Bold: el chat de WhatsApp del bot (https://wa.me/<número sin + ni espacios>).
BOLD_RETURN_URL=

# ── WhatsApp Flow del kit armado (casillas para elegir las mezclas) ──
# Se crea con: python -m app.whatsapp_flows crear <WABA_ID>   (sin ID, el kit se elige de una en una con listas)
WHATSAPP_KIT_FLOW_ID=
# draft mientras se prueba; published después de: python -m app.whatsapp_flows publicar
WHATSAPP_FLOWS_MODE=draft

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
